# ==========================================
# HouseHunt Chuka - Environment Variables Template
# NEVER COMMIT ACTUAL SECRET VALUES TO GIT REPOSITORIES
# ==========================================

# 1. Database Connection (PostgreSQL Neon)
DATABASE_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/househunt_chuka?sslmode=require"

# 2. NextAuth Authentication & Session Encryption Secrets
NEXTAUTH_URL="http://localhost:7000"
NEXTAUTH_SECRET="super-secret-random-32-byte-hex-key-here"

# 3. OAuth Providers (Google Login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. Cloudinary Image & Video Walkthrough Upload Secrets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="househunt-chuka"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 5. Paystack Subscription Gateway Secrets
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_1234567890abcdef"
PAYSTACK_SECRET_KEY="sk_test_1234567890abcdef"

# 6. Twilio / Africa's Talking OTP SMS Gateway (Phone Verification)
SMS_GATEWAY_API_KEY="your-sms-api-key"
SMS_GATEWAY_USERNAME="househunt"
